{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rightclickmaster.dev/schemas/config-v2.json",
  "title": "Right Click Master Configuration",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "enabledActions", "actionOrder", "language", "defaultRecipe", "postCreateBehavior"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "enabledActions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["newFile", "copyPath", "openTerminal", "openEditor"]
      }
    },
    "actionOrder": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["newFile", "copyPath", "openTerminal", "openEditor"]
      }
    },
    "preferredTerminal": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "applicationPath": { "type": ["string", "null"] }
      }
    },
    "preferredEditor": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "applicationPath": { "type": ["string", "null"] }
      }
    },
    "language": {
      "enum": ["system", "zh-Hans", "en"]
    },
    "defaultRecipe": {
      "enum": ["blank", "text", "markdown"]
    },
    "postCreateBehavior": {
      "enum": ["reveal", "openPreferredEditor", "openSystemAssociation"]
    },
    "onboardingStep": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    }
  }
}
